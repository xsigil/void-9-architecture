#!/bin/bash
set -euo pipefail

# すでにマウント名前空間を分離済みでなければ unshare して自分自身を再実行
if [ -z "${VOID_JAIL_UNSHARED:-}" ]; then
    export VOID_JAIL_UNSHARED=1
    exec unshare -m --propagation private /bin/bash "$0" "$@"
fi

# 1. バインドマウントの適用（プライベートなマウント名前空間内）
{{range .BindMounts}}
mkdir -p "{{.Dst}}"
if [ "{{.ReadOnly}}" = "true" ]; then
    mount --bind -o ro "{{.Src}}" "{{.Dst}}"
else
    mount --bind "{{.Src}}" "{{.Dst}}"
fi
{{end}}

# 2. 実行時ライブラリパスの設定
{{if .LibDir}}
export LD_LIBRARY_PATH="{{.LibDir}}:${LD_LIBRARY_PATH:-}"
{{end}}

# 3. 対象プロセスの実行
exec {{.ExecBin}} {{range .ExecArgs}}"{{.}}" {{end}}
