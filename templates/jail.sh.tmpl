#!/usr/bin/env bash
set -euo pipefail

JAIL_DIR="/run/void-jail-{{ .JailID }}"
TMPFS_SIZE="{{ .TmpfsSize }}"

if [[ $EUID -ne 0 ]]; then
    echo "[-] Void containment requires root privileges." >&2
    exit 1
fi

cleanup() {
    echo -e "\n[*] Collapsing Void jail (tmpfs) back to non-existence..."
{{- range .BindMounts }}
    umount -l "${JAIL_DIR}/{{ .Dst }}" 2>/dev/null || true
{{- end }}
    umount -l "${JAIL_DIR}/lib" 2>/dev/null || true
    umount -l "${JAIL_DIR}/lib64" 2>/dev/null || true
    umount -l "${JAIL_DIR}/usr" 2>/dev/null || true
    umount -l "${JAIL_DIR}" 2>/dev/null || true
    rm -rf "${JAIL_DIR}"
    echo "[*] Containment dissolved. 0 bytes persistent on host."
}
trap cleanup EXIT INT TERM

# 1. 揮発性 tmpfs を RAM 上にマウント
mkdir -p "${JAIL_DIR}"
mount -t tmpfs -o "size=${TMPFS_SIZE},nodev,nosuid" tmpfs "${JAIL_DIR}"

# 2. 最小限のディレクトリツリーを tmpfs 上に展開
mkdir -p "${JAIL_DIR}"/{bin,dev,proc,etc,tmp}

# 3. 疑似デバイスの作成
mknod -m 666 "${JAIL_DIR}/dev/null" c 1 3 2>/dev/null || true
mknod -m 666 "${JAIL_DIR}/dev/zero" c 1 5 2>/dev/null || true
mknod -m 666 "${JAIL_DIR}/dev/urandom" c 1 9 2>/dev/null || true

# 4. リゾルバの複製
[[ -f /etc/resolv.conf ]] && cp -a /etc/resolv.conf "${JAIL_DIR}/etc/" 2>/dev/null || true

# 5. ldd で集めたライブラリ群をバインド (まずは RW のままマウント)
LIB_DIR="{{ .LibDir }}"
if [[ -d "${LIB_DIR}" ]]; then
    if [[ -d "${LIB_DIR}/usr" ]]; then
        mkdir -p "${JAIL_DIR}/usr"
        mount --bind "${LIB_DIR}/usr" "${JAIL_DIR}/usr"
    fi

    for dir in lib lib64; do
        if [[ -d "${LIB_DIR}/${dir}" ]]; then
            mkdir -p "${JAIL_DIR}/${dir}"
            mount --bind "${LIB_DIR}/${dir}" "${JAIL_DIR}/${dir}"
        elif [[ -d "${JAIL_DIR}/usr/${dir}" && ! -e "${JAIL_DIR}/${dir}" ]]; then
            ln -s "usr/${dir}" "${JAIL_DIR}/${dir}"
        fi
    done
fi

# 6. 実行バイナリの配置
cp "{{ .ExecBin }}" "${JAIL_DIR}/bin/app"
chmod 755 "${JAIL_DIR}/bin/app"

# 7. ユーザー指定のバインドマウント投影 (マウント作成)
{{- range .BindMounts }}
if [[ -d "{{ .Src }}" ]]; then
    mkdir -p "${JAIL_DIR}/{{ .Dst }}"
    mount --bind "{{ .Src }}" "${JAIL_DIR}/{{ .Dst }}"
elif [[ -f "{{ .Src }}" ]]; then
    mkdir -p "$(dirname "${JAIL_DIR}/{{ .Dst }}")"
    touch "${JAIL_DIR}/{{ .Dst }}"
    mount --bind "{{ .Src }}" "${JAIL_DIR}/{{ .Dst }}"
else
    echo "[-] Error: Bind source does not exist: {{ .Src }}" >&2
    exit 1
fi
{{- end }}

# 8. すべてのマウント完了後に Read-Only 属性を一括適用
if [[ -d "${LIB_DIR}" ]]; then
    [[ -d "${LIB_DIR}/usr" ]] && mount -o remount,ro,bind "${JAIL_DIR}/usr" 2>/dev/null || true
    [[ -d "${LIB_DIR}/lib" ]] && mount -o remount,ro,bind "${JAIL_DIR}/lib" 2>/dev/null || true
    [[ -d "${LIB_DIR}/lib64" ]] && mount -o remount,ro,bind "${JAIL_DIR}/lib64" 2>/dev/null || true
fi

{{- range .BindMounts }}
{{- if .ReadOnly }}
mount -o remount,ro,bind "${JAIL_DIR}/{{ .Dst }}" 2>/dev/null || true
{{- end }}
{{- end }}

echo "[*] Launching unshared containment perimeter..."
# マウント、PID、IPC、UTS名前空間を分離して chroot 実行
exec unshare --mount --pid --ipc --uts --mount-proc="${JAIL_DIR}/proc" --fork chroot "${JAIL_DIR}" /bin/app {{ range .ExecArgs }}"{{ . }}" {{ end }}
