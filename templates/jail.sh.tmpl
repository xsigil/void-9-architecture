#!/usr/bin/env bash
set -euo pipefail

JAIL_DIR="/run/void-jail-{{ .JailID }}"
TMPFS_SIZE="{{ if .Size }}{{ .Size }}{{ else }}64M{{ end }}"

if [[ $EUID -ne 0 ]]; then
    echo "[-] Void containment requires root privileges." >&2
    exit 1
fi

cleanup() {
    echo -e "\n[*] Collapsing Void jail (tmpfs) back to non-existence..."
{{- range .BindMounts }}
    umount -l "${JAIL_DIR}/{{ .Dst }}" 2>/dev/null || true
{{- end }}
    umount -l "${JAIL_DIR}/lib64" 2>/dev/null || true
    umount -l "${JAIL_DIR}/lib" 2>/dev/null || true
    umount -l "${JAIL_DIR}/proc" 2>/dev/null || true
    umount -l "${JAIL_DIR}" 2>/dev/null || true
    rm -rf "${JAIL_DIR}"
    echo "[*] Containment dissolved. 0 bytes persistent on host."
}
trap cleanup EXIT INT TERM

echo "[*] Launching unshared containment perimeter (tmpfs: ${TMPFS_SIZE})..."
# 1. 揮発性 tmpfs マウント
mkdir -p "${JAIL_DIR}"
mount -t tmpfs -o "size=${TMPFS_SIZE},exec,dev,suid" tmpfs "${JAIL_DIR}"

# 2. ディレクトリツリー作成 (/lib, /lib64, /usr/lib)
mkdir -p "${JAIL_DIR}"/{bin,proc,dev,etc,tmp,lib,lib64,usr/lib}

# 3. 疑似デバイス
mknod -m 666 "${JAIL_DIR}/dev/null" c 1 3 2>/dev/null || true
mknod -m 666 "${JAIL_DIR}/dev/zero" c 1 5 2>/dev/null || true
mknod -m 666 "${JAIL_DIR}/dev/urandom" c 1 9 2>/dev/null || true

# 4. リゾルバ複製
[[ -f /etc/resolv.conf ]] && cp -a /etc/resolv.conf "${JAIL_DIR}/etc/" 2>/dev/null || true

# 5. ライブラリ群の確実なバインドマウント
LIB_DIR="{{ .LibDir }}"
if [[ -n "${LIB_DIR}" && -d "${LIB_DIR}" ]]; then
    # フラット配置・usr階層配置の双方に対応
    mount --bind -o ro "${LIB_DIR}" "${JAIL_DIR}/lib"
    mount --bind -o ro "${LIB_DIR}" "${JAIL_DIR}/lib64"
    mount --bind -o ro "${LIB_DIR}" "${JAIL_DIR}/usr/lib"
fi

# 6. 実行バイナリの配置
TARGET_BIN="$(basename "{{ .ExecBin }}")"
cp -a "{{ .ExecBin }}" "${JAIL_DIR}/bin/${TARGET_BIN}"
chmod 755 "${JAIL_DIR}/bin/${TARGET_BIN}"
if [[ "${TARGET_BIN}" != "app" ]]; then
    ln -sf "${TARGET_BIN}" "${JAIL_DIR}/bin/app"
fi

# 7. --bind 投影
{{- range .BindMounts }}
if [[ -d "{{ .Src }}" ]]; then
    mkdir -p "${JAIL_DIR}/{{ .Dst }}"
    mount --bind "{{ .Src }}" "${JAIL_DIR}/{{ .Dst }}"
elif [[ -f "{{ .Src }}" ]]; then
    mkdir -p "$(dirname "${JAIL_DIR}/{{ .Dst }}")"
    touch "${JAIL_DIR}/{{ .Dst }}"
    mount --bind "{{ .Src }}" "${JAIL_DIR}/{{ .Dst }}"
else
    echo "[-] Error: Bind source does not exist: {{ .Src }}" >&2
    exit 1
fi
{{ if .ReadOnly }}
mount -o remount,ro,bind "${JAIL_DIR}/{{ .Dst }}" 2>/dev/null || true
{{ end }}
{{- end }}

echo "[*] Launching unshared containment perimeter (tmpfs: ${TMPFS_SIZE})..."

# 8. chroot 実行
unshare --mount --pid --ipc --uts --mount-proc="${JAIL_DIR}/proc" --fork \
    env -i LD_LIBRARY_PATH=/lib:/lib64:/usr/lib PATH=/bin \
    chroot "${JAIL_DIR}" "/bin/${TARGET_BIN}" {{ range .ExecArgs }}"{{ . }}" {{ end }} &

CHILD_PID=$!
wait "${CHILD_PID}" 2>/dev/null || true
