package web

import (
	"fmt"
	"html"
	"net/http"

	"github.com/gin-gonic/gin"
	"github.com/google/uuid"
	"{{MODULE_NAME}}/internal/usecase"
)

type Handler struct {
	sampleUsecase *usecase.SampleUsecase
}

func NewHandler(sampleUsecase *usecase.SampleUsecase) *Handler {
	return &Handler{sampleUsecase: sampleUsecase}
}

func (h *Handler) Index(c *gin.Context) {
	items, err := h.sampleUsecase.List(c.Request.Context())
	if err != nil {
		c.String(http.StatusInternalServerError, err.Error())
		return
	}

	csrfToken, _ := c.Get("csrf_token")

	c.HTML(http.StatusOK, "base.html", gin.H{
		"Title":     "{{MODULE_NAME}}",
		"Items":     items,
		"CSRFToken": csrfToken,
	})
}

func (h *Handler) CreateItem(c *gin.Context) {
	val := c.PostForm("value")
	id := uuid.New().String()[:8]

	if err := h.sampleUsecase.Execute(c.Request.Context(), id, val); err != nil {
		c.String(http.StatusBadRequest, err.Error())
		return
	}

	// XSS対策: ユーザー入力を明示的にエスケープ
	safeVal := html.EscapeString(val)
	safeID := html.EscapeString(id)

	htmlSnippet := fmt.Sprintf(`<article id="item-%s"><strong>%s</strong>: %s</article>`, safeID, safeID, safeVal)
	c.Header("Content-Type", "text/html; charset=utf-8")
	c.String(http.StatusCreated, htmlSnippet)
}
