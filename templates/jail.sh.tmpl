#!/usr/bin/env bash
set -euo pipefail

JAIL_DIR="/run/void-jail-{{.JailID}}"
TMPFS_SIZE="{{.Size}}"

if [[ $EUID -ne 0 ]]; then
    echo "[-] Void containment requires root privileges." >&2
    exit 1
fi

cleanup() {
    echo -e "\n[*] Collapsing Void jail (tmpfs) back to non-existence..."
    umount -l "${JAIL_DIR}/usr/lib" 2>/dev/null || true
    umount -l "${JAIL_DIR}/dev" 2>/dev/null || true
    umount -l "${JAIL_DIR}/proc" 2>/dev/null || true
    umount -l "${JAIL_DIR}" 2>/dev/null || true
    rm -rf "${JAIL_DIR}"
    echo "[*] Containment dissolved. 0 bytes persistent on host."
}
trap cleanup EXIT INT TERM

echo "[*] Launching unshared containment perimeter (tmpfs: ${TMPFS_SIZE})..."

# 1. 揮発性 tmpfs マウント
mkdir -p "${JAIL_DIR}"
mount -t tmpfs -o "size=${TMPFS_SIZE},mode=0755,exec,suid" tmpfs "${JAIL_DIR}"
chmod 755 "${JAIL_DIR}"

# 2. 基本階層作成 (UsrMerge 準拠: 実体は usr 配下のみ)
mkdir -p "${JAIL_DIR}/usr"/{bin,lib,share}
mkdir -p "${JAIL_DIR}"/{proc,dev,etc,tmp,run}

# Jail 内部ルート (/) から正しく解決されるシンボリックリンク構成
ln -sfn /usr/bin "${JAIL_DIR}/bin"
ln -sfn /usr/bin "${JAIL_DIR}/sbin"
ln -sfn /usr/lib "${JAIL_DIR}/lib"
ln -sfn /usr/lib "${JAIL_DIR}/lib64"
ln -sfn /usr/lib "${JAIL_DIR}/usr/lib64"
ln -sfn /usr/share "${JAIL_DIR}/share"

# 3. 疑似デバイス
if ! mount -t devtmpfs devtmpfs "${JAIL_DIR}/dev" -o nosuid,noexec,mode=0755 2>/dev/null; then
    mount --bind /dev "${JAIL_DIR}/dev"
fi

# 4. ホスト情報の複製
[[ -f /etc/resolv.conf ]] && cp -aL /etc/resolv.conf "${JAIL_DIR}/etc/" 2>/dev/null || true
[[ -f /etc/passwd ]] && cp -aL /etc/passwd "${JAIL_DIR}/etc/" 2>/dev/null || true
[[ -f /etc/group ]] && cp -aL /etc/group "${JAIL_DIR}/etc/" 2>/dev/null || true
chmod 644 "${JAIL_DIR}/etc"/* 2>/dev/null || true

# 5. 引数バイナリ配置
{{range .ExecBins}}
SRC_BIN="{{.}}"
B_NAME="$(basename "${SRC_BIN}")"
cp -aL "${SRC_BIN}" "${JAIL_DIR}/usr/bin/${B_NAME}"
chmod 755 "${JAIL_DIR}/usr/bin/${B_NAME}"
{{end}}

TARGET_BIN="{{.TargetBin}}"
if [[ "${TARGET_BIN}" != "app" ]]; then
    ln -sfn "${TARGET_BIN}" "${JAIL_DIR}/usr/bin/app"
fi

# 6. --bind 投影
{{range .BindMounts}}
mkdir -p "$(dirname "${JAIL_DIR}{{.Dst}}")"
if [[ -d "{{.Src}}" ]]; then
    mkdir -p "${JAIL_DIR}{{.Dst}}" 2>/dev/null || true
    mount --bind "{{.Src}}" "${JAIL_DIR}{{.Dst}}"
else
    touch "${JAIL_DIR}{{.Dst}}" 2>/dev/null || true
    mount --bind "{{.Src}}" "${JAIL_DIR}{{.Dst}}"
fi
{{end}}

# 7. ライブラリ群のマウント
LIB_DIR="{{.LibDir}}"
if [[ -n "${LIB_DIR}" && -d "${LIB_DIR}" ]]; then
    if [[ -d "${LIB_DIR}/usr/lib" ]]; then
        mount --bind "${LIB_DIR}/usr/lib" "${JAIL_DIR}/usr/lib"
    elif [[ -d "${LIB_DIR}/lib" ]]; then
        mount --bind "${LIB_DIR}/lib" "${JAIL_DIR}/usr/lib"
    else
        mount --bind "${LIB_DIR}" "${JAIL_DIR}/usr/lib"
    fi
fi

chmod 755 "${JAIL_DIR}"
chmod -R 755 "${JAIL_DIR}/usr" "${JAIL_DIR}/etc" 2>/dev/null || true
chmod 1777 "${JAIL_DIR}/tmp"

{{if .Debug}}
# ----------------------------------------------------
# [DEBUG] Jail 内部ツリー & 依存解決ダンプ
# ----------------------------------------------------
echo "==================== [VOID JAIL DEBUG FS] ===================="
echo "[*] Jail Root: ${JAIL_DIR}"
echo "--- Active Mounts ---"
findmnt -R "${JAIL_DIR}" 2>/dev/null || cat /proc/mounts | grep "${JAIL_DIR}" || true
echo "--- Dynamic Linker & Symlink Resolution ---"
ls -ld "${JAIL_DIR}/bin" "${JAIL_DIR}/sbin" "${JAIL_DIR}/lib" "${JAIL_DIR}/lib64" "${JAIL_DIR}/usr/lib64" 2>/dev/null || true
echo "--- Loader Check via /lib64 ---"
ls -la "${JAIL_DIR}/lib64/ld-linux-x86-64.so.2" 2>/dev/null || echo "[-] Linker NOT FOUND in /lib64"
echo "=============================================================="
{{end}}

# 8. RO remount
{{range .BindMounts}}
{{if .ReadOnly}}
mount -o remount,ro,bind "${JAIL_DIR}{{.Dst}}"
{{end}}
{{end}}

# 9. 実行
# ホスト側の chroot (/usr/sbin/chroot 等) を発見できるよう PATH に /usr/sbin と /sbin を追加
RUN_USER="{{.User}}"

if [[ -n "${RUN_USER}" ]]; then
    env -i LD_LIBRARY_PATH=/usr/lib PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        unshare --mount --pid --ipc --uts --mount-proc="${JAIL_DIR}/proc" --fork \
        chroot --userspec="${RUN_USER}" "${JAIL_DIR}" \
        "/usr/bin/${TARGET_BIN}" {{range .ExecArgs}}"{{.}}" {{end}} &
else
    env -i LD_LIBRARY_PATH=/usr/lib PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        unshare --mount --pid --ipc --uts --mount-proc="${JAIL_DIR}/proc" --fork \
        chroot "${JAIL_DIR}" \
        "/usr/bin/${TARGET_BIN}" {{range .ExecArgs}}"{{.}}" {{end}} &
fi

CHILD_PID=$!
wait "${CHILD_PID}" 2>/dev/null || true