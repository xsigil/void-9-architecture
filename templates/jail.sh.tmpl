#!/bin/bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "[-] Void containment requires root privileges." >&2
    exit 1
fi

JAIL_DIR=$(mktemp -d /run/void-jail.XXXXXX)

cleanup() {
    # 内部バインドマウントの解除
    {{range .BindMounts}}
    umount -l "${JAIL_DIR}{{.Dst}}" 2>/dev/null || true
    {{end}}
    umount -l "${JAIL_DIR}/proc" 2>/dev/null || true
    umount -l "${JAIL_DIR}/usr" 2>/dev/null || true
    umount -l "${JAIL_DIR}" 2>/dev/null || true
    rm -rf "${JAIL_DIR}"
}
trap cleanup EXIT INT TERM

# 1. exec 可能な tmpfs ルートを作成
mount -t tmpfs -o "size=256M,exec,dev,suid" tmpfs "${JAIL_DIR}"

# 必要なディレクトリとシンボリックリンクの作成 (Arch Linux Merged /usr 構成)
mkdir -p "${JAIL_DIR}"/{usr,proc,dev,etc,tmp,var,run}
mount --bind -o ro /usr "${JAIL_DIR}/usr"

ln -s usr/bin "${JAIL_DIR}/bin"
ln -s usr/bin "${JAIL_DIR}/sbin"
ln -s usr/lib "${JAIL_DIR}/lib"
ln -s usr/lib "${JAIL_DIR}/lib64"

# 2. ユーザー指定バインドマウントの適用
{{range .BindMounts}}
mkdir -p "${JAIL_DIR}{{.Dst}}"
if [ "{{.ReadOnly}}" = "true" ]; then
    mount --bind -o ro "{{.Src}}" "${JAIL_DIR}{{.Dst}}"
else
    mount --bind "{{.Src}}" "${JAIL_DIR}{{.Dst}}"
fi
{{end}}

# 3. 実行時ライブラリパスの設定
{{if .LibDir}}
export LD_LIBRARY_PATH="{{.LibDir}}:${LD_LIBRARY_PATH:-}"
{{end}}

# 4. 完全名前空間分離 + chroot 実行
exec unshare --mount --pid --ipc --uts --mount-proc="${JAIL_DIR}/proc" --fork chroot "${JAIL_DIR}" {{.ExecBin}} {{range .ExecArgs}}"{{.}}" {{end}}
