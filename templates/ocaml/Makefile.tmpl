BIN_DIR ?= ./bin
TARGET  ?= $(BIN_DIR)/app

.PHONY: all build run clean

all: build

build:
	@mkdir -p $(BIN_DIR)
	@printf "[*] Compiling OCaml native executable via dune...\n"
	dune build --profile release bin/main.exe
	@cp -f _build/default/bin/main.exe $(TARGET)
	@chmod 755 $(TARGET)
	@printf "[+] Built successfully: %s\n" "$(TARGET)"

run: build
	DB_PATH="data/app.sqlite3" $(TARGET)

clean:
	dune clean
	@rm -f $(TARGET)
